{
  "info": {
    "name": "Patient-Doctor Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the requests top-to-bottom. Login saves the JWT automatically."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "mapping_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('access_token', j.tokens.access);",
                  "pm.collectionVariables.set('refresh_token', j.tokens.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "item": [
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"age\": 34,\n  \"gender\": \"M\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Agra, UP\",\n  \"medical_history\": \"Hypertension\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('patient_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            }
          }
        },
        {
          "name": "Get Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients",
                "{{patient_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients",
                "{{patient_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"age\": 35,\n  \"gender\": \"M\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Agra, UP\",\n  \"medical_history\": \"Hypertension\"\n}"
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients",
                "{{patient_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita Sharma\",\n  \"specialization\": \"cardiology\",\n  \"email\": \"anita@clinic.com\",\n  \"phone\": \"9123456780\",\n  \"experience_years\": 12\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('doctor_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            }
          }
        },
        {
          "name": "Get Doctor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors",
                "{{doctor_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors",
                "{{doctor_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita Sharma\",\n  \"specialization\": \"cardiology\",\n  \"email\": \"anita@clinic.com\",\n  \"phone\": \"9123456780\",\n  \"experience_years\": 13\n}"
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors",
                "{{doctor_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mappings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": \"{{patient_id}}\",\n  \"doctor\": \"{{doctor_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('mapping_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List All Mappings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mappings"
              ]
            }
          }
        },
        {
          "name": "Doctors of a Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mappings",
                "{{patient_id}}"
              ]
            }
          }
        },
        {
          "name": "Remove Doctor from Patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mappings",
                "{{mapping_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}